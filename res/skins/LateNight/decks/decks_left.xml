<!--
AI-generated (Claude Code). Start of AI-generated text.

Mix Two: the left deck windows (decks 1 and 3).
Each deck (Deck1_Src, Deck3_Src) is defined once, in skin.xml. A singleton
moves to the SingletonContainer that is shown, so each layout below has its
own containers, and only one of them is visible at a time.

  2-deck ([Skin],show_4decks = 0): one window. [Skin],left_deck_alt selects
    the page: 0 = deck 1, 1 = deck 3.
  4-deck, HUD ([LateNight],deck_hud = 1): the same one window. 4-deck mode
    adds only the mixer channels. It does not add deck windows.
  4-deck, old deck rows ([LateNight],deck_hud = 0): deck 3 under deck 1, as
    in LateNight.

End of AI-generated text.
-->
<Template>
  <SetVariable name="Type">deck</SetVariable>
  <WidgetGroup>
    <ObjectName>DecksLeft</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <!-- 2-deck: deck 1 or deck 3 -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <WidgetStack currentpage="[Skin],left_deck_alt">
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>vertical</Layout>
                <SizePolicy>me,min</SizePolicy>
                <Children>
                  <SingletonContainer>
                    <ObjectName>Deck1_Src</ObjectName>
                  </SingletonContainer>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <Layout>vertical</Layout>
                <SizePolicy>me,min</SizePolicy>
                <Children>
                  <SingletonContainer>
                    <ObjectName>Deck3_Src</ObjectName>
                  </SingletonContainer>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetStack>
        </Children>
        <Connection>
          <ConfigKey>[Skin],show_4decks</ConfigKey>
          <Transform><Not/></Transform>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

      <!-- 4-deck -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <WidgetStack currentpage="[LateNight],deck_hud">
            <SizePolicy>me,min</SizePolicy>
            <Children>

              <!-- old deck rows: deck 3 under deck 1 -->
              <WidgetGroup>
                <Layout>vertical</Layout>
                <SizePolicy>me,min</SizePolicy>
                <Children>
                  <SingletonContainer>
                    <ObjectName>Deck1_Src</ObjectName>
                  </SingletonContainer>
                  <WidgetGroup>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,min</SizePolicy>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>Deck3_Src</ObjectName>
                      </SingletonContainer>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>

              <!-- HUD: one window, the same as 2-deck -->
              <WidgetStack currentpage="[Skin],left_deck_alt">
                <SizePolicy>me,min</SizePolicy>
                <Children>
                  <WidgetGroup>
                    <Layout>vertical</Layout>
                    <SizePolicy>me,min</SizePolicy>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>Deck1_Src</ObjectName>
                      </SingletonContainer>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup>
                    <Layout>vertical</Layout>
                    <SizePolicy>me,min</SizePolicy>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>Deck3_Src</ObjectName>
                      </SingletonContainer>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetStack>

            </Children>
          </WidgetStack>
        </Children>
        <Connection>
          <ConfigKey>[Skin],show_4decks</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
