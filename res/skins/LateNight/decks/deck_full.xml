<Template>
  <WidgetGroup>
    <ObjectName>DeckContainer</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>Deck<Variable name="ChanNum"/></ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <!-- Mix Two: mirrored from the centre out: next to the mixer the
               rate column, then the deck hub, then the track rows.
               Decks 1/3: rows | hub | rate, decks 2/4: rate | hub | rows.
               The slots are set per deck in skin.xml (SlotLeft1/2,
               SlotRight1/2); unused ones hold empty placeholders. -->
          <SingletonContainer>
            <ObjectName>Deck<Variable name="SlotLeft1"/><Variable name="ChanNum"/></ObjectName>
          </SingletonContainer>
          <SingletonContainer>
            <ObjectName>Deck<Variable name="SlotLeft2"/><Variable name="ChanNum"/></ObjectName>
          </SingletonContainer>

          <WidgetGroup>
            <ObjectName>DeckRows12345</ObjectName>
            <SizePolicy>me,min</SizePolicy>
            <Layout>vertical</Layout>
            <Children>

              <Template src="skins:LateNight/decks/row_1_keyVinylFx.xml"/>

              <WidgetGroup>
                <ObjectName>DeckRows234</ObjectName>
                <SizePolicy>me,min</SizePolicy>
                <Layout>horizontal</Layout>
                <Children>

                  <WidgetGroup>
                    <SizePolicy>me,min</SizePolicy>
                    <Layout>vertical</Layout>
                    <Children>
                      <Template src="skins:LateNight/decks/row_2_3_TitleArtistTime.xml" />
                      <Template src="skins:LateNight/decks/row_4_overviewSpinny.xml" />
                    </Children>
                  </WidgetGroup>

                </Children>
              </WidgetGroup><!-- DeckRows234 -->

              <Template src="skins:LateNight/decks/row_5_transportLoopJump.xml" />

            </Children>
          </WidgetGroup><!-- DeckRows12345 -->

          <SingletonContainer>
            <ObjectName>Deck<Variable name="SlotRight1"/><Variable name="ChanNum"/></ObjectName>
          </SingletonContainer>
          <SingletonContainer>
            <ObjectName>Deck<Variable name="SlotRight2"/><Variable name="ChanNum"/></ObjectName>
          </SingletonContainer>
        </Children>
      </WidgetGroup><!-- DeckN -->
    </Children>
  </WidgetGroup>
</Template>
