<!--
Mix Two: CUE, REVERSE and PLAY/PAUSE, under the tempo in the deck hub
(moved from row_5_transportLoopJump.xml), and under them the rate +/- and
nudge buttons (moved from the rate column). Variables: Group
-->
<Template>
  <SetVariable name="BtnType"><Variable name="SubRegion_BtnType"/></SetVariable>
  <SetVariable name="BtnSize">square</SetVariable>

  <WidgetGroup><!-- Play, Cue, Reverse -->
    <ObjectName>HubTransport</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>max,min</SizePolicy>
    <Children>
      <WidgetGroup><!-- Cue | Reverse -->
        <Layout>horizontal</Layout>
        <Children>

          <CueButton>
            <TooltipId>cue_default_cue_gotoandstop</TooltipId>
            <ObjectName>CueDeck</ObjectName>
            <Size>42f,26f</Size>
            <NumberStates>2</NumberStates>
            <RightClickIsPushButton>true</RightClickIsPushButton>
            <Group><Variable name="Group"/></Group>
            <DndRectMargin><Variable name="DndRectMarginHotcueBtn"/></DndRectMargin>
            <State>
              <Number>0</Number>
              <Text><Variable name="state_0_text"/></Text>
              <Alignment><Variable name="Align"/></Alignment>
              <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_medium.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_medium_active.svg</Pressed>
            </State>
            <State>
              <Number>1</Number>
              <Text><Variable name="state_1_text"/></Text>
              <Alignment><Variable name="Align"/></Alignment>
              <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_medium_set.svg</Unpressed>
              <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn_<Variable name="BtnType"/>_medium_active.svg</Pressed>
            </State>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_default</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_gotoandstop</ConfigKey>
              <ButtonState>RightButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,cue_indicator</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </CueButton>

          <Template src="skins:LateNight/controls/button_1state_right.xml">
            <SetVariable name="TooltipId">reverse</SetVariable>
            <SetVariable name="ObjectName">Reverse</SetVariable>
            <SetVariable name="Size">26f,26f</SetVariable>
            <SetVariable name="BtnSize">square</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,reverse</SetVariable>
            <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,reverseroll</SetVariable>
          </Template>

        </Children>
      </WidgetGroup><!-- Reverse | Cue -->

      <WidgetGroup><!-- Play + PlayBlink + default dark background -->
        <Layout>stacked</Layout>
        <Size>68f,26f</Size>
        <Children>
          <Template src="skins:LateNight/controls/button_play_2state_right_display.xml">
            <SetVariable name="TooltipId">play_cue_set</SetVariable>
            <SetVariable name="ObjectName">PlayDeck</SetVariable>
            <SetVariable name="Size">68f,26f</SetVariable>
            <SetVariable name="BtnSize">play</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="Group"/>,play</SetVariable>
            <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,cue_set</SetVariable>
            <SetVariable name="ConfigKeyDisp"><Variable name="Group"/>,play_latched</SetVariable>
          </Template>
          <PushButton>
            <ObjectName>PreviewIndicator</ObjectName>
            <Size>68f,26f</Size>
            <NumberStates>2</NumberStates>
            <Connection>
              <ConfigKey><Variable name="Group"/>,play</ConfigKey>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>PlayIndicator</ObjectName>
            <Size>68f,26f</Size>
            <NumberStates>2</NumberStates>
            <Connection>
              <ConfigKey><Variable name="Group"/>,play_indicator</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup><!-- Play + PlayBlink + default dark background -->

            <WidgetGroup><!-- Rate +/- and nudge buttons, slower on the left -->
              <ObjectName>RateButtons</ObjectName>
              <Layout>horizontal</Layout>
              <SizePolicy>min,min</SizePolicy>
              <Children>
                <WidgetGroup><!-- Up = faster -->
                  <ObjectName>AlignLeft</ObjectName>
                  <Layout>horizontal</Layout>
                  <SizePolicy>min,min</SizePolicy>
                  <Children>
                    <Template src="skins:LateNight/controls/button_1state_right.xml">
                      <SetVariable name="TooltipId">rate_perm_down_rate_perm_down_small</SetVariable>
                      <SetVariable name="ObjectName">RatePermDown</SetVariable>
                      <SetVariable name="Size">17f,17f</SetVariable>
                      <SetVariable name="ConfigKey"><Variable name="Group"/>,rate_perm_down</SetVariable>
                      <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,rate_perm_down_small</SetVariable>
                    </Template>
                    <Template src="skins:LateNight/controls/button_1state_right.xml">
                      <SetVariable name="TooltipId">rate_temp_down_rate_temp_down_small</SetVariable>
                      <SetVariable name="ObjectName">RateTempDown</SetVariable>
                      <SetVariable name="Size">17f,17f</SetVariable>
                      <SetVariable name="ConfigKey"><Variable name="Group"/>,rate_temp_down</SetVariable>
                      <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,rate_temp_down_small</SetVariable>
                    </Template>
                    <Template src="skins:LateNight/controls/button_1state_right.xml">
                      <SetVariable name="TooltipId">rate_temp_up_rate_temp_up_small</SetVariable>
                      <SetVariable name="ObjectName">RateTempUp</SetVariable>
                      <SetVariable name="Size">17f,17f</SetVariable>
                      <SetVariable name="ConfigKey"><Variable name="Group"/>,rate_temp_up</SetVariable>
                      <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,rate_temp_up_small</SetVariable>
                    </Template>
                    <Template src="skins:LateNight/controls/button_1state_right.xml">
                      <SetVariable name="TooltipId">rate_perm_up_rate_perm_up_small</SetVariable>
                      <SetVariable name="ObjectName">RatePermUp</SetVariable>
                      <SetVariable name="Size">17f,17f</SetVariable>
                      <SetVariable name="ConfigKey"><Variable name="Group"/>,rate_perm_up</SetVariable>
                      <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,rate_perm_up_small</SetVariable>
                    </Template>
                  </Children>
                  <Connection>
                    <ConfigKey><Variable name="Group"/>,rate_dir</ConfigKey>
                    <Transform><IsEqual>1</IsEqual></Transform>
                    <BindProperty>visible</BindProperty>
                  </Connection>
                </WidgetGroup><!-- /Rate buttons for up=faster -->

                <WidgetGroup><!-- Up = slower -->
                  <Layout>horizontal</Layout>
                  <SizePolicy>min,min</SizePolicy>
                  <Children>
                    <Template src="skins:LateNight/controls/button_1state_right.xml">
                      <SetVariable name="TooltipId">rate_perm_down_rate_perm_down_small</SetVariable>
                      <SetVariable name="ObjectName">RatePermDown</SetVariable>
                      <SetVariable name="Size">17f,17f</SetVariable>
                      <SetVariable name="ConfigKey"><Variable name="Group"/>,rate_perm_down</SetVariable>
                      <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,rate_perm_down_small</SetVariable>
                    </Template>

                    <Template src="skins:LateNight/controls/button_1state_right.xml">
                      <SetVariable name="TooltipId">rate_temp_down_rate_temp_down_small</SetVariable>
                      <SetVariable name="ObjectName">RateTempDownRev</SetVariable>
                      <SetVariable name="Size">17f,17f</SetVariable>
                      <SetVariable name="ConfigKey"><Variable name="Group"/>,rate_temp_down</SetVariable>
                      <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,rate_temp_down_small</SetVariable>
                    </Template>

                    <Template src="skins:LateNight/controls/button_1state_right.xml">
                      <SetVariable name="TooltipId">rate_temp_up_rate_temp_up_small</SetVariable>
                      <SetVariable name="ObjectName">RateTempUpRev</SetVariable>
                      <SetVariable name="Size">17f,17f</SetVariable>
                      <SetVariable name="ConfigKey"><Variable name="Group"/>,rate_temp_up</SetVariable>
                      <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,rate_temp_up_small</SetVariable>
                    </Template>

                    <Template src="skins:LateNight/controls/button_1state_right.xml">
                      <SetVariable name="TooltipId">rate_perm_up_rate_perm_up_small</SetVariable>
                      <SetVariable name="ObjectName">RatePermUp</SetVariable>
                      <SetVariable name="Size">17f,17f</SetVariable>
                      <SetVariable name="ConfigKey"><Variable name="Group"/>,rate_perm_up</SetVariable>
                      <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,rate_perm_up_small</SetVariable>
                    </Template>
                  </Children>
                  <Connection>
                    <ConfigKey><Variable name="Group"/>,rate_dir</ConfigKey>
                    <Transform><IsEqual>-1</IsEqual></Transform>
                    <BindProperty>visible</BindProperty>
                  </Connection>
                </WidgetGroup><!-- /Rate buttons for up=slower -->
              </Children>
              <Connection>
                <ConfigKey>[Skin],show_rate_control_buttons</ConfigKey>
                <BindProperty>visible</BindProperty>
              </Connection>
            </WidgetGroup><!-- Rate +/- and nudge buttons, slower on the left -->

    </Children>
  </WidgetGroup>
</Template>
