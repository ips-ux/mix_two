<Template>

  <!-- Empty placeholders for the unused mirrored slots -->
  <SingletonDefinition>
    <ObjectName>HudEmptyA<Variable name="ChanNum"/></ObjectName>
    <Children>
      <WidgetGroup><Size>0f,0min</Size></WidgetGroup>
    </Children>
  </SingletonDefinition>
  <SingletonDefinition>
    <ObjectName>HudEmptyB<Variable name="ChanNum"/></ObjectName>
    <Children>
      <WidgetGroup><Size>0f,0min</Size></WidgetGroup>
    </Children>
  </SingletonDefinition>

  <WidgetGroup>
    <ObjectName>HudContainer</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <SingletonContainer>
        <ObjectName><Variable name="HudRateL"/><Variable name="ChanNum"/></ObjectName>
      </SingletonContainer>

      <WidgetGroup>
        <ObjectName>HudDeck</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <WidgetGroup>
            <ObjectName>HudWindow</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <Template src="skins:LateNight/decks/hud_header.xml"/>
              <WidgetGroup><Size>0min,5f</Size></WidgetGroup>
              <Template src="skins:LateNight/decks/hud_trackinfo.xml"/>
              <WidgetGroup><Size>0min,5f</Size></WidgetGroup>
              <Template src="skins:LateNight/decks/hud_waves.xml"/>
            </Children>
          </WidgetGroup><!-- HudWindow -->

          <!-- Lower panel (HOT CUE | GRID / PHRASE | MEMORY CUE | INFO):
               not built yet. -->
          <WidgetGroup>
            <ObjectName>HudLowerPanelSlot</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children/>
            <Connection>
              <ConfigKey persist="true">[LateNight],show_lower_panel</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>

        </Children>
      </WidgetGroup><!-- HudDeck -->

      <SingletonContainer>
        <ObjectName><Variable name="HudRateR"/><Variable name="ChanNum"/></ObjectName>
      </SingletonContainer>

    </Children>
  </WidgetGroup><!-- HudContainer -->
</Template>
