<Template>

  <WidgetGroup>
    <Layout>vertical</Layout>
    <Children>

      <Template src="skins:LateNight/decks/deck_singletons.xml">
        <SetVariable name="Type">deck</SetVariable>
        <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
      </Template>

      <!-- Mix Two (AI-generated, Claude Code): [LateNight],deck_hud
           selects the deck window. Page 0: the old LateNight deck rows
           (mini / compact / full). Page 1: the CDJ-style HUD window
           (decks/deck_hud.xml). With the HUD, deck_size_without_mixer does
           not apply. End of AI-generated text. -->
      <WidgetStack currentpage="[LateNight],deck_hud" persist="true">
        <Children>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <!-- Mix Two: taller than LateNight (230) for the deck hub and the
                 round SYNC / KEY SYNC buttons. -->
            <MaximumSize>,290</MaximumSize>
            <Children>
              <WidgetStack currentpage="[Skin],show_mixer" persist="true">
                <Children>

                  <!-- no mixer -->
                  <WidgetStack currentpage="[LateNight],deck_size_without_mixer" persist="true">
                    <Children>
                      <!-- minimal deck selected -->
                      <WidgetGroup trigger="[LateNight],show_mini_deck">
                        <Layout>horizontal</Layout>
                        <Children>
                          <SingletonContainer>
                            <ObjectName>Deck<Variable name="ChanNum"/>_Mini</ObjectName>
                          </SingletonContainer>
                        </Children>
                      </WidgetGroup>
                      <!-- Compact deck selected -->
                      <WidgetGroup trigger="[LateNight],show_compact_deck">
                        <Layout>horizontal</Layout>
                        <Children>
                        <SingletonContainer>
                          <ObjectName>Deck<Variable name="ChanNum"/>_Compact</ObjectName>
                        </SingletonContainer>
                        </Children>
                      </WidgetGroup>
                      <!-- Full deck selected -->
                      <WidgetGroup trigger="[LateNight],show_full_deck">
                        <Layout>horizontal</Layout>
                        <Children>
                          <SingletonContainer>
                            <ObjectName>Deck<Variable name="ChanNum"/>_Full</ObjectName>
                          </SingletonContainer>
                        </Children>
                      </WidgetGroup>
                    </Children>
                  </WidgetStack>

                  <!-- mixer shown = full deck -->
                  <WidgetGroup trigger="[Skin],show_mixer" on_hide_select="0">
                    <Layout>horizontal</Layout>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>Deck<Variable name="ChanNum"/>_Full</ObjectName>
                      </SingletonContainer>
                    </Children>
                  </WidgetGroup>

                </Children>
              </WidgetStack>
            </Children>
          </WidgetGroup><!-- old deck rows -->

          <WidgetGroup>
            <Layout>vertical</Layout>
            <Children>
              <Template src="skins:LateNight/decks/deck_hud.xml">
                <SetVariable name="Type">deck</SetVariable>
                <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
              </Template>
            </Children>
          </WidgetGroup><!-- HUD window -->

        </Children>
      </WidgetStack>

    </Children>
  </WidgetGroup>
</Template>
