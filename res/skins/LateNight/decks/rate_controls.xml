<Template>
  <SetVariable name="BtnType"><Variable name="TopRegion_BtnType"/></SetVariable>
  <SetVariable name="BtnSize">square</SetVariable>

  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>min,me</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>DeckRateSeparator</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>min,me</SizePolicy>
        <Children/>
        <!-- this is sized and styled in css -->
       </WidgetGroup>

      <WidgetGroup>
        <ObjectName>RateContainer</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>min,me</SizePolicy>
        <Children>

          <!-- Mix Two: SYNC, KEY SYNC and MT. BPM, slider BPM, tempo % and
               the tempo range live in the deck hub (deck_hub.xml). -->
          <WidgetGroup>
            <ObjectName>BpmTapSyncContainer</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>


              <!-- Mix Two: round SYNC and KEY SYNC, modelled on the DDJ-800.
                   SYNC: click turns sync on or off, right-click makes the
                   deck MASTER. Its light is blue while synced and red-orange
                   on the MASTER; its label follows Preferences > Decks > Sync
                   options: GRID (Grid Lock) or BPM (BPM Sync). KEY is KEY SYNC. -->
              <WidgetGroup>
                <ObjectName>SyncKeySyncBox</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>min,min</SizePolicy>
                <Children>
                  <WidgetGroup>
                    <ObjectName>AlignCenter</ObjectName>
                    <Layout>stacked</Layout>
                    <Size>34f,34f</Size>
                    <Children>
                      <!-- on top: takes the clicks -->
                      <PushButton>
                        <TooltipId>sync_enabled</TooltipId>
                        <ObjectName>SyncRoundClick</ObjectName>
                        <Size>34f,34f</Size>
                        <NumberStates>2</NumberStates>
                        <RightClickIsPushButton>true</RightClickIsPushButton>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,sync_enabled</ConfigKey>
                          <ButtonState>LeftButton</ButtonState>
                        </Connection>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,sync_leader_toggle</ConfigKey>
                          <ButtonState>RightButton</ButtonState>
                        </Connection>
                      </PushButton>
                      <!-- underneath: the round button with its light -->
                      <PushButton>
                        <ObjectName>SyncRound</ObjectName>
                        <Size>34f,34f</Size>
                        <NumberStates>6</NumberStates>
                      <State>
                        <Number>0</Number>
                        <Text>GRID</Text>
                      </State>
                      <State>
                        <Number>1</Number>
                        <Text>GRID</Text>
                      </State>
                      <State>
                        <Number>2</Number>
                        <Text>GRID</Text>
                      </State>
                      <State>
                        <Number>3</Number>
                        <Text>BPM</Text>
                      </State>
                      <State>
                        <Number>4</Number>
                        <Text>BPM</Text>
                      </State>
                      <State>
                        <Number>5</Number>
                        <Text>BPM</Text>
                      </State>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,sync_indicator</ConfigKey>
                          <ConnectValueFromWidget>false</ConnectValueFromWidget>
                        </Connection>
                      </PushButton>
                    </Children>
                  </WidgetGroup>

                  <WidgetGroup><Size>0min,3f</Size></WidgetGroup>

                  <!-- KEY SYNC: click turns it on or off, right-click resets
                       the key. Blue while on. -->
                  <WidgetGroup>
                    <ObjectName>AlignCenter</ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>min,min</SizePolicy>
                    <Children>
                      <PushButton>
                        <TooltipId>sync_reset_key</TooltipId>
                        <ObjectName>KeySyncRound</ObjectName>
                        <Size>34f,34f</Size>
                        <NumberStates>2</NumberStates>
                        <RightClickIsPushButton>true</RightClickIsPushButton>
                        <State>
                          <Number>0</Number>
                          <Text>KEY</Text>
                        </State>
                        <State>
                          <Number>1</Number>
                          <Text>KEY</Text>
                        </State>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,keysync_enabled</ConfigKey>
                          <ButtonState>LeftButton</ButtonState>
                        </Connection>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,reset_key</ConfigKey>
                          <ButtonState>RightButton</ButtonState>
                        </Connection>
                      </PushButton>
                    </Children>
                  </WidgetGroup>

                </Children>
              </WidgetGroup><!-- SyncKeySyncBox -->
            </Children>
          </WidgetGroup><!-- BpmTapSyncContainer -->

          <!-- Mix Two: MT (master tempo = key lock), as on the DDJ-800: a
               small round button with a light in its centre, red while on,
               and its title below. Two equal spacers keep it half way
               between KEY and the top of the tempo slider. -->
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
          <WidgetGroup>
            <ObjectName>AlignCenter</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
              <WidgetGroup>
                <ObjectName>AlignCenter</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>min,min</SizePolicy>
                <Children>
                  <PushButton>
                    <TooltipId>master_tempo</TooltipId>
                    <ObjectName>MasterTempoRound</ObjectName>
                    <Size>24f,24f</Size>
                    <NumberStates>2</NumberStates>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,keylock</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
              <Label>
                <ObjectName>MasterTempoLabel</ObjectName>
                <Text>MT</Text>
              </Label>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>

          <WidgetGroup>
            <ObjectName>RateControls</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>

              <WidgetGroup><!-- Rate slider + range displays -->
                <ObjectName>RateSliderBox</ObjectName>
                <Layout>stacked</Layout>
                <SizePolicy>max,me</SizePolicy>
                <Children>

                  <!-- Rate slider + center indicator -->
                  <WidgetGroup>
                    <Size>54f,121f</Size>
                    <Children>
                      <Label>
                        <ObjectName>RateCenter</ObjectName>
                        <Size>5f,5f</Size>
                        <Pos>2,59</Pos>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,rate_set_default</ConfigKey>
                          <BindProperty>highlight</BindProperty>
                        </Connection>
                      </Label>
                      <SliderComposed>
                        <ObjectName>RateSlider</ObjectName>
                        <Size>40f,119f</Size>
                        <Pos>5,2</Pos>
                        <TooltipId>rate</TooltipId>
                        <Handle scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="SliderScheme"/>/sliders/knob_pitch_deck.svg</Handle>
                        <Slider scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="SliderScheme"/>/sliders/slider_pitch_deck.svg</Slider>
                        <Horizontal>false</Horizontal>
                        <BarWidth><Variable name="BarWidth"/></BarWidth>
                        <BarMargins><Variable name="BarMarginPitch"/></BarMargins>
                        <BarColor><Variable name="BarColorPitch"/></BarColor>
                        <BarRoundCaps>true</BarRoundCaps>
                        <BarAxisPos>20.0</BarAxisPos>
                        <BarUnipolar>false</BarUnipolar>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,rate</ConfigKey>
                        </Connection>
                      </SliderComposed>
                    </Children>
                  </WidgetGroup><!-- Rate slider + center indicator -->

                  <WidgetGroup><!-- Rate range indicators -->
                    <SizePolicy>min,me</SizePolicy>
                    <Layout>vertical</Layout>
                    <Children>
                      <SingletonContainer>
                        <ObjectName>RateRangeDisplayTop<Variable name="ChanNum"/></ObjectName>
                      </SingletonContainer>
                      <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
                      <SingletonContainer>
                        <ObjectName>RateRangeDisplayBottom<Variable name="ChanNum"/></ObjectName>
                      </SingletonContainer>
                    </Children>
                  </WidgetGroup><!-- Rate range indicators -->
                </Children>
              </WidgetGroup><!-- Rate slider + range displays -->

              <!-- Mix Two: the rate +/- and nudge buttons moved under PLAY
                   (decks/transport_buttons.xml). -->
            </Children>
          </WidgetGroup><!-- RateControls -->

          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>

        </Children>
      </WidgetGroup><!-- RateContainer -->

    </Children>
    <Connection>
      <ConfigKey persist="true">[Skin],show_rate_controls</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
