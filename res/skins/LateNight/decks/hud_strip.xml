<!--
AI-generated (Claude Code). Start of AI-generated text.

Mix Two: HUD bottom strip (hud_waves.xml), 44 px.
  A.HOT CUE | AUTO CUE | QUANTIZE | NEXT CUE | REMAIN / TIME
  * A.HOT CUE, AUTO CUE: right-click = on / off ([Controls],auto_hotcue_toggle,
    [Controls],auto_cue_toggle); left-click does nothing. The cell is lit (white
    text, orange border) while the setting is on.
  * QUANTIZE: left-click = quantize on / off; right-click = next beat value
    (quantize_beats_cycle: 1 > 1/8 > 1/4 > 1/2 > 1). The value line shows
    quantize_beats. Legacy skins have no context menu, and the right button
    of a PushButton is always a push, so a push control does the cycle.
  * NEXT CUE: bars.beats (4 beats per bar) from the play position to the
    next hot cue or memory cue (beats_to_next_cue); - when there is no
    cue ahead or no beat grid.
  * REMAIN / TIME: the play position. Click it to change between elapsed,
    remaining and both ([Controls],ShowDurationRemaining).
The LOOP badge is in the phase meter row (hud_waves.xml).

End of AI-generated text.
-->
<Template>
  <WidgetGroup>
    <ObjectName>HudStrip</ObjectName>
    <Layout>horizontal</Layout>
    <Size>0me,44f</Size>
    <Children>

      <!-- A.HOT CUE: right-click pushes [Controls],auto_hotcue_toggle (a WPushButton
           does not toggle on the right button); the cell is lit while auto_hotcue is 1 -->
      <WidgetGroup>
        <Layout>stacked</Layout>
        <Size>66f,44f</Size>
        <Children>
          <PushButton>
            <ObjectName>HudLoadSettingButton</ObjectName>
            <Tooltip>A.HOT CUE: right-click to set on or off. When on, the hot cues load with the track.</Tooltip>
            <Size>66f,44f</Size>
            <NumberStates>2</NumberStates>
            <Connection>
              <ConfigKey>[Controls],auto_hotcue_toggle</ConfigKey>
              <ButtonState>RightButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[Controls],auto_hotcue</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <WidgetGroup>
            <ObjectName>HudStripCell</ObjectName>
            <Layout>vertical</Layout>
            <Size>66f,44f</Size>
            <Children>
              <Label>
                <ObjectName>HudStripLabel</ObjectName>
                <Size>0me,0me</Size>
                <Alignment>center</Alignment>
                <Text>A.HOT CUE</Text>
                <Connection>
                  <ConfigKey>[Controls],auto_hotcue</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </Label>
              <Label>
                <ObjectName>HudStripLabelOff</ObjectName>
                <Size>0me,0me</Size>
                <Alignment>center</Alignment>
                <Text>A.HOT CUE</Text>
                <Connection>
                  <ConfigKey>[Controls],auto_hotcue</ConfigKey>
                  <Transform><Not/></Transform>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </Label>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>5f,0min</Size></WidgetGroup>

      <!-- AUTO CUE: right-click pushes [Controls],auto_cue_toggle; the cell is lit
           while auto_cue is 1 -->
      <WidgetGroup>
        <Layout>stacked</Layout>
        <Size>66f,44f</Size>
        <Children>
          <PushButton>
            <ObjectName>HudLoadSettingButton</ObjectName>
            <Tooltip>AUTO CUE: right-click to set on or off. When on, the track starts at the first sound.</Tooltip>
            <Size>66f,44f</Size>
            <NumberStates>2</NumberStates>
            <Connection>
              <ConfigKey>[Controls],auto_cue_toggle</ConfigKey>
              <ButtonState>RightButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[Controls],auto_cue</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <WidgetGroup>
            <ObjectName>HudStripCell</ObjectName>
            <Layout>vertical</Layout>
            <Size>66f,44f</Size>
            <Children>
              <Label>
                <ObjectName>HudStripLabel</ObjectName>
                <Size>0me,0me</Size>
                <Alignment>center</Alignment>
                <Text>AUTO CUE</Text>
                <Connection>
                  <ConfigKey>[Controls],auto_cue</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </Label>
              <Label>
                <ObjectName>HudStripLabelOff</ObjectName>
                <Size>0me,0me</Size>
                <Alignment>center</Alignment>
                <Text>AUTO CUE</Text>
                <Connection>
                  <ConfigKey>[Controls],auto_cue</ConfigKey>
                  <Transform><Not/></Transform>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </Label>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>5f,0min</Size></WidgetGroup>

      <!-- QUANTIZE: the button lies on top of the cell text -->
      <WidgetGroup>
        <Layout>stacked</Layout>
        <Size>66f,44f</Size>
        <Children>
          <PushButton>
            <ObjectName>HudQuantizeButton</ObjectName>
            <Tooltip>Left-click: set quantize on or off. Right-click: change the beat value.</Tooltip>
            <Size>66f,44f</Size>
            <NumberStates>2</NumberStates>
            <Connection>
              <ConfigKey><Variable name="Group"/>,quantize</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,quantize_beats_cycle</ConfigKey>
              <ButtonState>RightButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup>
            <ObjectName>HudStripCell</ObjectName>
            <Layout>vertical</Layout>
            <Size>66f,44f</Size>
            <Children>
              <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
              <Label>
                <ObjectName>HudStripLabel</ObjectName>
                <Size>0me,12f</Size>
                <Alignment>center</Alignment>
                <Text>QUANTIZE</Text>
              </Label>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,20f</Size>
                <Children>
                  <Label>
                    <ObjectName>HudStripValue</ObjectName>
                    <Size>0me,20f</Size>
                    <Alignment>center</Alignment>
                    <Text>1/8</Text>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,quantize_beats</ConfigKey>
                      <Transform><IsEqual>0.125</IsEqual></Transform>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                  <Label>
                    <ObjectName>HudStripValue</ObjectName>
                    <Size>0me,20f</Size>
                    <Alignment>center</Alignment>
                    <Text>1/4</Text>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,quantize_beats</ConfigKey>
                      <Transform><IsEqual>0.25</IsEqual></Transform>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                  <Label>
                    <ObjectName>HudStripValue</ObjectName>
                    <Size>0me,20f</Size>
                    <Alignment>center</Alignment>
                    <Text>1/2</Text>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,quantize_beats</ConfigKey>
                      <Transform><IsEqual>0.5</IsEqual></Transform>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                  <Label>
                    <ObjectName>HudStripValue</ObjectName>
                    <Size>0me,20f</Size>
                    <Alignment>center</Alignment>
                    <Text>1</Text>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,quantize_beats</ConfigKey>
                      <Transform><IsEqual>1</IsEqual></Transform>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                </Children>
              </WidgetGroup>
              <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>5f,0min</Size></WidgetGroup>

      <WidgetGroup>
        <ObjectName>HudStripCell</ObjectName>
        <Layout>vertical</Layout>
        <Size>66f,44f</Size>
        <Children>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
          <Label>
            <ObjectName>HudStripLabel</ObjectName>
            <Size>0me,12f</Size>
            <Alignment>center</Alignment>
            <Text>NEXT CUE</Text>
          </Label>
          <BeatCount>
            <ObjectName>HudStripValue</ObjectName>
            <Size>0me,20f</Size>
            <Alignment>center</Alignment>
            <Connection>
              <ConfigKey><Variable name="Group"/>,beats_to_next_cue</ConfigKey>
            </Connection>
          </BeatCount>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>5f,0min</Size></WidgetGroup>

      <WidgetGroup>
        <ObjectName>HudStripCell</ObjectName>
        <Layout>vertical</Layout>
        <Size>0me,44f</Size>
        <Children>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Size>0me,12f</Size>
            <Children>
              <Label>
                <ObjectName>HudStripLabel</ObjectName>
                <Size>0me,12f</Size>
                <Alignment>center</Alignment>
                <Text>REMAIN</Text>
                <Connection>
                  <ConfigKey>[Controls],ShowDurationRemaining</ConfigKey>
                  <Transform><IsEqual>1</IsEqual></Transform>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </Label>
              <Label>
                <ObjectName>HudStripLabel</ObjectName>
                <Size>0me,12f</Size>
                <Alignment>center</Alignment>
                <Text>TIME</Text>
                <Connection>
                  <ConfigKey>[Controls],ShowDurationRemaining</ConfigKey>
                  <Transform><IsEqual>1</IsEqual><Not/></Transform>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </Label>
            </Children>
          </WidgetGroup>
          <NumberPos>
            <ObjectName>HudTimeText</ObjectName>
            <TooltipId>track_time</TooltipId>
            <Size>0me,24f</Size>
            <Alignment>center</Alignment>
            <Channel><Variable name="ChanNum"/></Channel>
            <Connection>
              <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
            </Connection>
          </NumberPos>
          <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup><!-- HudStrip -->
</Template>
