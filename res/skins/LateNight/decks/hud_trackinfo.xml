<!--
AI-generated (Claude Code). Start of AI-generated text.

Mix Two: HUD track info row (deck_hud.xml).
  Decks 1, 3:  KEY | BPM block | title / artist | art      (art on the mixer edge)
  Decks 2, 4:  art | title / artist | BPM block | KEY
HudStats<N> (BPM block + KEY box) and HudArt<N> swap with the HudInfoL /
HudInfoR slots; inside HudStats<N>, BPM and KEY swap with HudStatsL /
HudStatsR. The titles align to the outside edge (HudTitleAlign).
BPM block: BPM (click: BPM tools), MASTER badge while this deck is the sync
leader, tempo %, tempo range (click: next range), MT while key lock is on.

End of AI-generated text.
-->
<Template>

  <SingletonDefinition>
    <ObjectName>HudArt<Variable name="ChanNum"/></ObjectName>
    <Children>
      <WidgetGroup><!-- the parser renames this outer group to the singleton name -->
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <ObjectName>HudArtBox</ObjectName>
            <Layout>horizontal</Layout>
            <Size>58f,58f</Size>
            <Children>
              <CoverArt>
                <ObjectName>HudCoverArt</ObjectName>
                <TooltipId>coverart</TooltipId>
                <Size>58f,58f</Size>
                <Group><Variable name="Group"/></Group>
                <DefaultCover>skins:LateNight/<Variable name="StyleScheme"/>/style/cover_default.svg</DefaultCover>
              </CoverArt>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>HudTitles<Variable name="ChanNum"/></ObjectName>
    <Children>
      <WidgetGroup><!-- the parser renames this outer group to the singleton name -->
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <ObjectName>HudTitles</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>i,min</SizePolicy>
            <Children>
              <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
              <TrackProperty>
                <ObjectName>HudTitle</ObjectName>
                <TooltipId>track_title</TooltipId>
                <Size>0me,24f</Size>
                <Property>titleInfo</Property>
                <Alignment><Variable name="HudTitleAlign"/></Alignment>
                <Elide>right</Elide>
                <Channel><Variable name="ChanNum"/></Channel>
              </TrackProperty>
              <TrackProperty>
                <ObjectName>HudArtist</ObjectName>
                <TooltipId>track_artist</TooltipId>
                <Size>0me,20f</Size>
                <Property>artist</Property>
                <Alignment><Variable name="HudTitleAlign"/></Alignment>
                <Elide>right</Elide>
                <Channel><Variable name="ChanNum"/></Channel>
              </TrackProperty>
              <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>HudBpm<Variable name="ChanNum"/></ObjectName>
    <Children>
      <WidgetGroup><!-- the parser renames this outer group to the singleton name -->
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <ObjectName>HudBpmBlock</ObjectName>
            <Layout>vertical</Layout>
            <Size>118f,58f</Size>
            <Children>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,12f</Size>
                <Children>
                  <Label>
                    <ObjectName>HudStatLabel</ObjectName>
                    <Size>24f,12f</Size>
                    <Text>BPM</Text>
                  </Label>
                  <WidgetGroup><Size>4f,0min</Size></WidgetGroup>
                  <Label>
                    <ObjectName>HudMasterBadge</ObjectName>
                    <Size>46f,12f</Size>
                    <Alignment>center</Alignment>
                    <Text>MASTER</Text>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,sync_leader</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                  <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <Layout>stacked</Layout>
                <Size>0me,26f</Size>
                <Children>
                  <!-- invisible BPM tools on top of the BPM -->
                  <BpmEditor>
                    <TooltipId>visual_bpm_edit</TooltipId>
                    <Size>0me,26f</Size>
                    <Group><Variable name="Group"/></Group>
                  </BpmEditor>
                  <Number>
                    <ObjectName>HudBpmValue</ObjectName>
                    <TooltipId>visual_bpm</TooltipId>
                    <Size>0me,26f</Size>
                    <Alignment>left</Alignment>
                    <NumberOfDigits>2</NumberOfDigits>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
                    </Connection>
                  </Number>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Size>0me,16f</Size>
                <Children>
                  <NumberRate>
                    <ObjectName>HudRateText</ObjectName>
                    <TooltipId>rate_display</TooltipId>
                    <Size>52f,16f</Size>
                    <Alignment>left</Alignment>
                    <Channel><Variable name="ChanNum"/></Channel>
                    <NumberOfDigits>1</NumberOfDigits>
                  </NumberRate>
                  <WidgetGroup>
                    <Layout>stacked</Layout>
                    <Size>40f,16f</Size>
                    <Children>
                      <PushButton>
                        <TooltipId>rate_range_next</TooltipId>
                        <ObjectName>HubRateRangeButton</ObjectName>
                        <Size>40f,16f</Size>
                        <NumberStates>1</NumberStates>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,rate_range_next</ConfigKey>
                          <ButtonState>LeftButton</ButtonState>
                        </Connection>
                      </PushButton>
                      <RateRange>
                        <TooltipId>rate_range_next</TooltipId>
                        <ObjectName>HudRateRange</ObjectName>
                        <Channel><Variable name="ChanNum"/></Channel>
                        <Display>symmetric</Display>
                        <Size>40f,16f</Size>
                      </RateRange>
                    </Children>
                  </WidgetGroup>
                  <Label>
                    <ObjectName>HudMtLabel</ObjectName>
                    <TooltipId>keylock</TooltipId>
                    <Size>20f,16f</Size>
                    <Alignment>center</Alignment>
                    <Text>MT</Text>
                    <Connection>
                      <ConfigKey><Variable name="Group"/>,keylock</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Label>
                  <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup><!-- HudBpmBlock -->
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>HudKey<Variable name="ChanNum"/></ObjectName>
    <Children>
      <WidgetGroup><!-- the parser renames this outer group to the singleton name -->
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <ObjectName>HudKeyBox</ObjectName>
            <Layout>vertical</Layout>
            <Size>64f,58f</Size>
            <Children>
              <Label>
                <ObjectName>HudStatLabel</ObjectName>
                <Size>0me,12f</Size>
                <Alignment>center</Alignment>
                <Text>KEY</Text>
              </Label>
              <Key>
                <ObjectName>HudKeyValue</ObjectName>
                <TooltipId>visual_key</TooltipId>
                <Channel><Variable name="ChanNum"/></Channel>
                <Size>0me,30f</Size>
                <Alignment>center</Alignment>
                <Elide>right</Elide>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,visual_key</ConfigKey>
                </Connection>
              </Key>
              <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
            </Children>
          </WidgetGroup><!-- HudKeyBox -->
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>HudStats<Variable name="ChanNum"/></ObjectName>
    <Children>
      <WidgetGroup><!-- the parser renames this outer group to the singleton name -->
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <ObjectName>HudStats</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
              <SingletonContainer>
                <ObjectName><Variable name="HudStatsL"/><Variable name="ChanNum"/></ObjectName>
              </SingletonContainer>
              <WidgetGroup><Size>5f,0min</Size></WidgetGroup>
              <SingletonContainer>
                <ObjectName><Variable name="HudStatsR"/><Variable name="ChanNum"/></ObjectName>
              </SingletonContainer>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <WidgetGroup>
    <ObjectName>HudTrackInfo</ObjectName>
    <Layout>horizontal</Layout>
    <Size>0me,58f</Size>
    <Children>
      <SingletonContainer>
        <ObjectName><Variable name="HudInfoL"/><Variable name="ChanNum"/></ObjectName>
      </SingletonContainer>
      <WidgetGroup><Size>6f,0min</Size></WidgetGroup>
      <SingletonContainer>
        <ObjectName>HudTitles<Variable name="ChanNum"/></ObjectName>
      </SingletonContainer>
      <WidgetGroup><Size>6f,0min</Size></WidgetGroup>
      <SingletonContainer>
        <ObjectName><Variable name="HudInfoR"/><Variable name="ChanNum"/></ObjectName>
      </SingletonContainer>
    </Children>
  </WidgetGroup><!-- HudTrackInfo -->
</Template>
